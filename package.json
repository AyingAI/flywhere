{
  "name": "flywhere",
  "version": "0.3.0",
  "private": true,
  "productName": "飞哪里 FlyWhere",
  "main": "desktop/main.js",
  "description": "固定日期，根据真实往返票价探索目的地。",
  "author": "AyingAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AyingAI/flywhere.git"
  },
  "homepage": "https://github.com/AyingAI/flywhere#readme",
  "bugs": "https://github.com/AyingAI/flywhere/issues",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "package:mac": "electron-builder --config electron-builder.config.js --dir --mac --arm64",
    "make:mac": "electron-builder --config electron-builder.config.js --mac dmg --arm64",
    "make:mac:universal": "electron-builder --config electron-builder.config.js --mac dmg --universal",
    "make:win": "electron-builder --config electron-builder.config.js --win nsis --x64",
    "check": "node --check server.js && node --check desktop/main.js && node --check electron-builder.config.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@fly-ai/flyai-cli": "1.0.16",
    "electron": "43.8.10",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/universal": "3.0.6",
    "app-builder-lib": {
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
